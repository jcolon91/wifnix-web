# ============================================================
# WIFNIX LLC — VARIABLES DE ENTORNO
# Copia este archivo como .env y llena los valores
# NUNCA subas .env a GitHub
# ============================================================

# SERVIDOR
NODE_ENV=production
PORT=3001

# BASE DE DATOS PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wifnix
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD_AQUI
DB_SSL=false

# JWT (cambia esto por una cadena aleatoria larga)
JWT_SECRET=CAMBIA_ESTO_POR_ALGO_SEGURO_MINIMO_32_CARACTERES

# ============================================================
# STRIPE — https://dashboard.stripe.com/apikeys
# ============================================================
STRIPE_SECRET_KEY=sk_test_REEMPLAZA_CON_TU_LLAVE
STRIPE_PUBLISHABLE_KEY=pk_live_test_REEMPLAZA_CON_TU_LLAVE
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZA_CON_TU_LLAVE

# ============================================================
# PAYPAL — https://developer.paypal.com/dashboard/
# ============================================================
PAYPAL_CLIENT_ID=XXXXXXXXXXXX
PAYPAL_SECRET=XXXXXXXXXXXX
PAYPAL_MODE=live  # 'sandbox' para pruebas

# ============================================================
# ATH MOVIL — https://github.com/evertec/athmovil-javascript-api
# ============================================================
ATH_MOVIL_PUBLIC_TOKEN=XXXXXXXXXXXX
ATH_MOVIL_PRIVATE_TOKEN=XXXXXXXXXXXX

# ============================================================
# KLARNA — https://docs.klarna.com/
# ============================================================
KLARNA_USERNAME=XXXXXXXXXXXX
KLARNA_PASSWORD=XXXXXXXXXXXX

# ============================================================
# ANTHROPIC (Claude AI — Chat)
# https://console.anthropic.com/api-keys
# ============================================================
ANTHROPIC_API_KEY=sk-ant-REEMPLAZA_CON_TU_LLAVE

# ============================================================
# CLOUDINARY (Fotos de perfil) — Opcional
# https://cloudinary.com/
# ============================================================
CLOUDINARY_CLOUD_NAME=XXXXXXXXXXXX
CLOUDINARY_API_KEY=XXXXXXXXXXXX
CLOUDINARY_API_SECRET=XXXXXXXXXXXX

# ============================================================
# EMAIL (para notificaciones)
# ============================================================
SMTP_HOST=smtp.titan.email
SMTP_PORT=587
SMTP_USER=sales@wifnix.com
SMTP_PASS=TU_PASSWORD_TITAN

# DOMINIO FRONTEND
FRONTEND_URL=https://wifnix.com

# ── RESEÑAS DE GOOGLE ────────────────────────────────────────
# Llave de Google Maps Platform con la Places API (New) activada.
# Restríngela por dominio/IP en la consola de Google.
GOOGLE_PLACES_API_KEY=

# El Place ID del perfil de Wifnix. Se saca en:
# https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=

# Enlace al perfil, por si la API no está configurada todavía.
GOOGLE_PERFIL_URL=

# ── ENTRAR CON GOOGLE, APPLE, MICROSOFT O FACEBOOK ──────────
# Cada proveedor exige registrar una aplicacion y autorizar la URL
# de retorno EXACTA:  https://api.wifnix.com/api/auth/oauth/<proveedor>/callback
# Los que queden vacios simplemente no ensenan su boton.

# console.cloud.google.com  →  APIs y servicios  →  Credenciales
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# portal.azure.com  →  Entra ID  →  Registros de aplicaciones
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# developers.facebook.com  →  Mi app  →  Inicio de sesion con Facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# developer.apple.com  →  Certificates, Identifiers & Profiles
# APPLE_CLIENT_ID es el Services ID, no el Bundle ID.
# APPLE_PRIVATE_KEY es el contenido del .p8, con \n en vez de saltos.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# A donde vuelve el usuario despues de entrar.
PORTAL_URL=https://portal.wifnix.com
API_URL=https://api.wifnix.com

# ── WIFNIX AI STUDIO (lib/ai-studio.js) ─────────────────────
# Llave de la API de Higgsfield: console.higgsfield.ai  →  API keys.
# Formato  id:secreto  (las dos partes, separadas por dos puntos).
# Es un producto aparte del plan de higgsfield.ai: se recarga en dólares allí.
HF_CREDENTIALS=

# Precio al cliente = costo de Higgsfield × AI_MULTIPLICADOR (nunca menos de 1.10),
# redondeado hacia arriba, y nunca menos de AI_MINIMO_CENTAVOS.
AI_MULTIPLICADOR=2
AI_MINIMO_CENTAVOS=25
# Tope por generación (centavos). Evita que una configuración cara sorprenda al cliente.
AI_MAXIMO_CENTAVOS=2500
# Paquetes de recarga en dólares
AI_PAQUETES=10,25,50,100

# Secreto del webhook de Stripe para AI Studio (endpoint aparte):
# Stripe → Developers → Webhooks → Add endpoint
#   URL:     https://api.wifnix.com/api/ai/stripe/webhook
#   Eventos: checkout.session.completed, checkout.session.async_payment_succeeded,
#            charge.refunded, charge.dispute.created
STRIPE_AI_WEBHOOK_SECRET=whsec_REEMPLAZA

# Token largo y aleatorio para la URL del webhook de Higgsfield.
# Generar con:  openssl rand -hex 24
AI_WEBHOOK_TOKEN=

# Dónde se guardan los videos e imágenes (Higgsfield los borra a los 7 días)
AI_STORAGE_DIR=/var/www/wifnix/ai-media
# Secreto para firmar los enlaces de descarga (openssl rand -hex 32)
AI_FIRMA_SECRET=
# Correo que recibe alertas: saldo de Higgsfield agotado, disputas
AI_ALERTA_EMAIL=Jcolon91@wifnix.com
# A dónde vuelve el cliente después de pagar
AI_STUDIO_URL=https://portal.wifnix.com/ai-studio.html
